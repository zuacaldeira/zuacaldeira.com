# The frontend and backend each have their own .gitignore.

# IDEs and editors
.idea/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# System files
.DS_Store
Thumbs.db
__pycache__/

# Claude Code: local settings (per machine, e.g. the lab's monitor hooks)
.claude/settings.local.json
